# Required for weather comparison agents (OpenAI tool-calling model)
# Verify key: pytest tests/test_openai_key.py -v
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.1

# Signal Researcher (Agent 1)
# ANTHROPIC_API_KEY=sk-ant-your-key-here  # optional — only if using Anthropic models
SERPER_API_KEY=your-serper-key-here
STAGE1_MODEL=openai/gpt-5.1
STAGE2_MODEL=openai/gpt-5.1
STAGE2_MAX_TOKENS=4096
SIGNAL_SUMMARY_MAX_CHARS=280
SIGNAL_EXCERPT_MAX_CHARS=400
SIGNAL_SPARSE_THRESHOLD=2
SIGNAL_MAX_RETRIES=2

# CrewAI memory (OpenAI embeddings by default; set MEMORY_EMBEDDER_* to override)
CREW_MEMORY_STORAGE=.crewai/memory
# LLM for memory analysis (defaults to OPENAI_MODEL, then gpt-5.1)
MEMORY_LLM_MODEL=gpt-5.1
# MEMORY_EMBEDDER_PROVIDER=ollama
# MEMORY_EMBEDDER_MODEL=mxbai-embed-large

# Scoring Engine (Agent 2)
SCORER_MODEL=openai/gpt-5.1
PRIORITISER_MODEL=openai/gpt-5.1
SCORING_MAX_RETRIES=2
SCORER_MAX_TOKENS=2048

# Dossier Compiler (Agent 3)
DOSSIER_MODEL=openai/gpt-5.1

# Outreach Drafter (Agent 4)
OUTREACH_MODEL=openai/gpt-5.1
OUTREACH_SENDER_FIRST_NAME=Alex
OUTREACH_SENDER_TITLE=Enterprise Account Executive
OUTREACH_SENDER_COMPANY=Acme GRC
# Optional overrides for product context (defaults match GRC platform ICP in code)
# OUTREACH_PRODUCT=
# OUTREACH_BUYER_TITLE=
# OUTREACH_TARGET_INDUSTRY=
# OUTREACH_CORE_PAIN=
# OUTREACH_KEY_OUTCOMES=

# Orchestrator
ORCHESTRATOR_BATCH_SIZE=5
ORCHESTRATOR_MAX_WORKERS=5

# Reference log for crew outputs (separate from vector memory in .crewai/memory)
CREW_OUTPUT_LOG=output/crew_outputs.jsonl
# CREW_OUTPUT_MD=output/crew_outputs.md
